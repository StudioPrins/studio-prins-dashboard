# Kopieer naar .env.local en vul in. Deze waarden NOOIT committen.

# Inloggen — toegestane gebruikers (komma-gescheiden), delen hetzelfde wachtwoord
AUTH_EMAILS=jij@voorbeeld.nl,collega@voorbeeld.nl
# bcrypt-hash van het wachtwoord.
#  - LOKAAL (.env.local): escape elke $ met \$  (bv. \$2b\$12\$...)
#  - OP VERCEL: plak de RAUWE hash zonder backslashes
# Genereer met: node -e "console.log(require('bcryptjs').hashSync('JOUW_WACHTWOORD',12))"
AUTH_PASSWORD_HASH=

# Willekeurig geheim voor sessie-ondertekening (min. 32 tekens)
# Genereer met: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Neon Postgres connectie-string (Vercel Marketplace → Neon)
DATABASE_URL=

# --- Mailassistent ---------------------------------------------------------
# Anthropic API-key voor categorisatie + conceptantwoorden (Claude).
# Aanmaken op https://platform.claude.com → Settings → API Keys
ANTHROPIC_API_KEY=

# AES-256-GCM-sleutel voor IMAP/SMTP-wachtwoorden (32 bytes hex, 64 tekens).
# Genereer met: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAIL_SECRET=

# Beveiligt de cron-route /api/cron/mail-sync. Op Vercel wordt deze automatisch
# als "Authorization: Bearer <CRON_SECRET>" meegestuurd bij cron-aanroepen.
# Genereer met: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# --- Onboarding: mail versturen (Resend) -----------------------------------
# API-key uit resend.com → API Keys. Je eigen domein moet daar geverifieerd zijn.
RESEND_API_KEY=
# Afzender, exact zo (naam + adres op het geverifieerde domein)
RESEND_FROM=Jouw Bedrijf <hallo@voorbeeld.nl>

# --- Onboarding: Google Drive-map per klant ---------------------------------
# Uit Google Cloud Console → APIs & Services → Credentials → OAuth client
# (type "Desktop app"). Zonder deze drie gaat de mail zonder Drive-link.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Eenmalig ophalen met: npx tsx scripts/google-auth.ts
GOOGLE_REFRESH_TOKEN=
# ID van de Drive-map waaronder de klantmappen komen (uit de map-URL:
# https://drive.google.com/drive/folders/<DIT_STUK>)
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# Basis-URL voor de links in de onboardingmail (formulier + Drive).
# Lokaal: http://localhost:3000 — online: de URL van je Vercel-project
APP_BASE_URL=http://localhost:3000

# --- Demo-omgeving ---------------------------------------------------------
# Zet op 1 in de publieke demo-deploy: geen inlog, verzonnen data, en alle
# acties die de buitenwereld raken (mail, IMAP, Drive, Claude) zijn geblokkeerd.
# Ook de vangrail van npm run db:demo-seed, dat script wist alle rijen.
NEXT_PUBLIC_DEMO=
